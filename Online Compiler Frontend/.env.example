# For local development, leave these blank to use Vite's same-origin proxy.
# Vite proxies REST and WebSocket /api requests to Spring Boot on localhost:8080.
VITE_API_BASE_URL=
VITE_EXECUTION_WS_URL=

# For a remote backend, set only this base URL. The WebSocket URL is derived automatically:
# VITE_API_BASE_URL=http://localhost:8080
# Optional legacy override (normally leave blank):
# VITE_EXECUTION_WS_URL=ws://localhost:8080/ws/execute
